<%= seam_start %>
<div class="chart">
  <canvas id="<%= chart_id %>" width="<%= canvas_width %>" height="<%= canvas_height %>"></canvas>
</div>
<script>
new Chart(document.getElementById('<%= chart_id %>').getContext('2d'),
{
  type: 'bar',
  data: {
    datasets: <%= JSON.generate(data_sets) %>
  },
  options: {
    responsive: <%= canvas_responsive? %>, // If responsive is true then it fills the screen
    indexAxis: 'y', // Make the bars horizontal
    scales: {
      x: {
        type: 'time',
        min: '<%= @date_range.begin.to_s %>',
        max: '<%= (@date_range.end + 1).to_s %>',
        stacked: false,
        <%= render_axis_title :x %>
        grid: {
          color: <%= CssVariable['--grid-line-color'].to_json %>
        },
      },
      y: {
        stacked: true,
        position: 'right',
        ticks: {
          display: true
        },
        <%= render_axis_title :y %>
        grid: {
          color: <%= CssVariable['--grid-line-color'].to_json %>
        },
      }
    },
    plugins: {
      annotation: {
        annotations: {
          <%= working_days_annotation %>

          <% percentage_lines.each do |percentage_line| %>
          <%= percentage_line[:id].to_json %>: {
            type: 'line',
            scaleID: 'x',
            value: '<%= percentage_line[:x] %>',
            borderColor: <%= CssVariable.new('--aging-work-bar-chart-percentage-line-color').to_json %>,
            borderWidth: 1,
            hitTolerance: 6,
            drawTime: 'afterDraw',
            label: {
              display: false,
              content: <%= "#{ordinal percentage_line[:percentile]} percentile of completed work".to_json %>,
              position: 'start',
              backgroundColor: 'rgba(0,0,0,0.85)',
              color: '#fff',
              font: { size: 11 }
            },
            enter(ctx) { ctx.element.label.options.display = true; ctx.chart.draw(); },
            leave(ctx) { ctx.element.label.options.display = false; ctx.chart.draw(); }
          },
          <% end %>
        }
      },
      legend: {
        display: false
      },
      tooltip: {
        callbacks: {
          label: function(context) {
            return context.dataset.data[context.dataIndex].title
          }
        }
      }
    }
  }
});
</script>
<%= seam_end %>
